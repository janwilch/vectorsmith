{
  "mcpServers": {
    "invoices": {
      "command": "vectorsmith",
      "args": [
        "serve",
        "examples/qdrant_invoices/tools.invoices.yaml",
        "--env-file",
        "examples/qdrant_invoices/.env.example",
        "--name",
        "invoices"
      ]
    },
    "tickets": {
      "command": "vectorsmith",
      "args": [
        "serve",
        "examples/qdrant_invoices/tools.tickets.yaml",
        "--env-file",
        "examples/qdrant_invoices/.env.example",
        "--name",
        "tickets"
      ]
    }
  }
}
